# ═══════════════════════════════════════════════════════════════════════════
#  JARVIS — Konfiguration
#  Kopieren nach .env und ausfüllen. .env steht in .gitignore und bleibt lokal.
#  Leere Werte = Funktion aus. Nichts davon gehört in ein Repository.
# ═══════════════════════════════════════════════════════════════════════════

# ── Profil ──────────────────────────────────────────────────────────────────
# Wie Jarvis den User anspricht. Leer = neutral ("User").
JARVIS_USER_NAME=
# Ort für Wetter und Briefing (Anzeige) und Koordinaten (open-meteo.com)
JARVIS_PLACE=
JARVIS_WEATHER_LAT=50.11
JARVIS_WEATHER_LON=8.68
JARVIS_TIMEZONE=Europe/Berlin
# Browser für das HUD und für "öffne Website" (voller Pfad). Leer = Standardbrowser.
JARVIS_BROWSER=
JARVIS_OPEN=1
# Mini-Fenster auf dem Desktop, solange der HUD-Tab nicht sichtbar ist (0 = aus).
# Aussehen: panda (Roboter-Panda mit Gesichtern) oder karte (alte Karte mit Orb).
JARVIS_OVERLAY=1
JARVIS_OVERLAY_STYLE=panda

# ── Gehirn (Claude Code über das Claude-Abo) ───────────────────────────────
# NIEMALS ANTHROPIC_API_KEY setzen — sonst wird per API statt über das Abo abgerechnet.
# 1 = schlanker Modus (eigener Prompt, Werkzeuggruppen, keine Sitzung), 0 = Sitzungsmodus
JARVIS_LEAN=1
# Einfache Befehle ohne LLM (Haus, Musik, Zeit, Wetter, Systeme)
JARVIS_LOCAL_ROUTER=1
JARVIS_MODEL_SIMPLE=haiku
JARVIS_MODEL_SMART=sonnet
JARVIS_MODEL=sonnet
JARVIS_EFFORT=low
JARVIS_MAX_OUTPUT_TOKENS=1500
JARVIS_HISTORY_TURNS=4
JARVIS_HISTORY_MAX_AGE_MIN=30
JARVIS_TIMEOUT=180
# Sitzungsmodus (JARVIS_LEAN=0): Rechte und Sitzungsgröße
JARVIS_PERMISSION=acceptEdits
JARVIS_ALLOWED_TOOLS=Read,Glob,Grep,WebSearch,WebFetch
JARVIS_SESSION_MAX_TOKENS=50000
# Tagesbriefing: Fakten im Code, 1 = ein kurzer Haiku-Aufruf formuliert, 0 = reiner Text
JARVIS_BRIEFING_LLM=1

# ── Server ──────────────────────────────────────────────────────────────────
# Protokoll logs/jarvis.log (JSON-Zeilen): Stufe INFO; einzelne Module auf DEBUG, z. B. voice_engine,router
JARVIS_LOG_LEVEL=INFO
JARVIS_LOG_DEBUG=
JARVIS_PORT=8720
# Arbeitsordner = Gedächtnis: nur hier darf Jarvis ohne Bestätigung schreiben
JARVIS_WORKDIR=vault
JARVIS_DEMO=0

# ── Stimme: Anbieter-Kette ──────────────────────────────────────────────────
# Reihenfolge; leere/aufgebrauchte Anbieter werden bis zum Reset übersprungen.
TTS_CHAIN=fish,elevenlabs,local,azure,google,edge
# Kurze Ansage beim Anbieterwechsel
TTS_ANNOUNCE_SWITCH=1

# Fish Audio — https://fish.audio/app/api-keys/
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro-free
FISH_AUDIO_VOICE_ID=
FISH_AUDIO_LATENCY=balanced

# ElevenLabs — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# eleven_flash_v2_5 = schnell; eleven_v3 = ausdrucksstark mit [Tags]
ELEVENLABS_MODEL=eleven_flash_v2_5

# Lokale GPU-Stimme (local_tts_server.py, Umgebung .venv-tts) — Fallback: Piper auf der CPU
LOCAL_TTS_URL=http://127.0.0.1:8730

# Azure Speech (Free Tier F0: 0,5 Mio. Zeichen/Monat) — portal.azure.com → Speech service
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
AZURE_VOICE=de-DE-FlorianMultilingualNeural

# Google Cloud Text-to-Speech (Free Tier, Konto mit Abrechnung nötig)
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=de-DE-Chirp3-HD-Charon

# Microsoft Edge (kostenlos, letzter Ausweg)
JARVIS_TTS=edge
EDGE_VOICE=de-DE-FlorianMultilingualNeural
EDGE_RATE=+5%

# ── Hören ───────────────────────────────────────────────────────────────────
# local = Whisper auf diesem PC (GPU wenn vorhanden), elevenlabs = Scribe (Credits)
JARVIS_STT=local
ELEVENLABS_STT_LANG=deu
# Wörter, die Whisper sicher schreiben soll (Namen, Geräte, Dienste)
WHISPER_LOCAL_PROMPT=Jarvis, Sir, Spotify, Home Assistant, Raspberry Pi, NAS, Claude, Briefing

# ── Sprach-Engine ───────────────────────────────────────────────────────────
# Zuhören, Satzende, Unterbrechen und Weitersprechen laufen auf dem Server (config/voice.yaml:
# Schwellen, Zeiten, Port 8724). Diese Variable zeigt auf eine andere Config-Datei; leer = config/voice.yaml.
# Einmalig: .venv\Scripts\python.exe scripts\fetch_voice_models.py (Silero VAD nach models/).
#JARVIS_VOICE_CONFIG=

# ── Aktivierungswort ────────────────────────────────────────────────────────
# off  = jede Äußerung zählt (wie bisher)
# text = nur Sätze, die mit „Jarvis …“ beginnen (nichts zu installieren)
# oww  = openWakeWord hört lokal auf „Hey Jarvis“; fehlt es, gilt „text“
#        .venv\Scripts\python.exe -m pip install openwakeword sounddevice
JARVIS_WAKE=off
JARVIS_WAKE_MODEL=hey_jarvis
JARVIS_WAKE_THRESHOLD=0.5
# Mikrofon für openWakeWord (Name oder Nummer laut sounddevice), leer = Standard
JARVIS_WAKE_DEVICE=
# Sekunden, die das Mikro nach „Jarvis“ offen bleibt / nach jeder Antwort ohne Aktivierungswort
JARVIS_WAKE_WINDOW_S=7
JARVIS_FOLLOWUP_S=8
# Aktivierungswort direkt auf iPad/iPhone (einmalig: scripts\fetch_wakeword.py). Ab diesem Wert
# geht ein Clip an den PC. „Hey Jarvis“ erreicht ~0,99, ein deutsches „Jarvis“ allein ~0,03–0,1.
# Ein Clip bis 8 s (eine normale Bitte) muss nur über 0,004 liegen, außer bei Musik/Sport im Raum.
# logs/wake_device.log zeigt jeden Clip mit Wert — kommt „Jarvis“ nicht durch, hier senken.
JARVIS_WAKE_LOCAL_THRESHOLD=0.02
# Welches Modell auf dem Gerät entscheidet: hey_jarvis (offiziell, „Hey Jarvis“), jarvis_v1 oder
# jarvis_v2 (Community, nur „Jarvis“; v1 empfindlicher, v2 weniger Fehlalarme). Die übrigen laufen
# zum Vergleich mit und stehen mit ihrem Wert in logs/wake_device.log. Die Schwelle oben passt zu
# hey_jarvis — nach dem Wechsel anhand des Logs neu setzen.
JARVIS_WAKE_LOCAL_MODEL=hey_jarvis
# Hintergrund-Erkennung: Home Assistant meldet laufende Mediaplayer (Musik, Sport, TV), dann
# zählt „Jarvis“ nur am Satzanfang/-ende und das Display rät zu „Hey Jarvis“. 0 = nur das Mikro.
JARVIS_AMBIENCE=1
# Mediaplayer, die nie im Raum zu hören sind (Regex auf entity_id oder Namen)
JARVIS_AMBIENCE_IGNORE=

# ── Spotify (alle Geräte des Kontos, auch das Handy an der Anlage) ─────────────
# Bei „Jarvis“ wird die Musik ganz leise (oder pausiert), damit er dich klar versteht, danach wie vorher.
# „Musik aus“, „nächster Titel“ gehen dann auch ans Handy. Braucht Premium (Family reicht).
# Einmalig: App auf developer.spotify.com anlegen, Redirect URI http://127.0.0.1:8722/callback,
# Web API anhaken, Client ID hier eintragen, dann  .venv\Scripts\python.exe scripts\spotify_login.py
JARVIS_SPOTIFY_CLIENT_ID=
# 0 = beim Aktivierungswort nicht pausieren (Musikbefehle gehen trotzdem übers Konto)
JARVIS_SPOTIFY_HOLD=1
# Spätestens nach so vielen Sekunden läuft die Musik wieder, falls das HUD sich nicht meldet
JARVIS_SPOTIFY_HOLD_MAX_S=120
# leise = Musik läuft auf JARVIS_SPOTIFY_QUIET_FACTOR ihrer Lautstärke weiter (0.3 = ein Drittel), höchstens
# JARVIS_SPOTIFY_QUIET_PCT Prozent, und kommt danach auf die alte Lautstärke; gilt beim „Jarvis“ und bei jeder
# Ansage. pause = anhalten wie früher. Geräte, deren Lautstärke Spotify nicht setzen kann, werden pausiert.
JARVIS_SPOTIFY_HOLD_MODE=leise
JARVIS_SPOTIFY_QUIET_FACTOR=0.3
JARVIS_SPOTIFY_QUIET_PCT=20

# ── Sonos ───────────────────────────────────────────────────────────────────
# Antworten eines Geräts (z. B. iPad) auf einem Sonos statt aus dem Gerät, als Durchsage über Home
# Assistant: Musik wird leiser und läuft danach weiter. Umschalten im HUD („🔈 Ton hier“), auf dem iPad
# unter ⋯. Liste: media_player.x=Name, mehrere mit Komma. Leer = aus. Der Sonos holt die Clips von
# http://<PC-Adresse>:JARVIS_SONOS_PORT (nur GET, Zufallsname, 10 Minuten gültig, nur private Adressen).
JARVIS_SONOS=
JARVIS_SONOS_PORT=8723
# JARVIS_SONOS_HOST=10.0.0.145   # leer = die Adresse, über die Home Assistant erreichbar ist
JARVIS_SONOS_VOLUME=0.35
# Nachts (JARVIS_QUIET_HOURS) spricht der Sonos so laut und geht danach auf seine eigene Lautstärke zurück
JARVIS_SONOS_NIGHT_VOLUME=0.1
# Wie bei Alexa: Musik auf dem Sonos dieses Geräts geht auf diese Lautstärke, solange Jarvis zuhört,
# nachdenkt und antwortet (gilt auch für AirPlay und die Sonos-App). Danach kommt die alte zurück.
JARVIS_SONOS_QUIET=0.12

# ── Von selbst melden ───────────────────────────────────────────────────────
# Timer, Wecker und Erinnerungen klingeln immer. Hinweise (Waschmaschine fertig,
# Termin gleich, neues Gerät …) werden in den Ruhezeiten nur angezeigt.
JARVIS_PROACTIVE=1
JARVIS_QUIET_HOURS=22-7
# Minuten vor einem Termin ansagen, 0 = aus
JARVIS_EVENT_LEAD_MIN=15
# Speicher ab diesem Ladestand als „voll“ melden (einmal am Tag, 10–17 Uhr)
JARVIS_STORAGE_FULL=98
# Geräte mit Leistungsmesser: config/home.json → "appliances" (Vorlage in home.example.json)

# ── Listen ──────────────────────────────────────────────────────────────────
# To-do-Entity in Home Assistant (dann auch in der HA-App sichtbar), leer = Notiz im Vault
JARVIS_SHOPPING_LIST=todo.shopping_list
JARVIS_TODO_LIST=

# ── Ersatz-Gehirn, wenn Claude ausfällt oder das Limit erreicht ist ────────
# Kette in dieser Reihenfolge, alle mit denselben Werkzeugen und Bestätigungskarten.
# off = aus. Fehlt ein Schlüssel, wird das Glied übersprungen.
JARVIS_FALLBACK=groq,gemini,ollama
# Wer private Gespräche (Mail, Kalender, Gesundheit) sehen darf — Gemini free trainiert ggf. mit
JARVIS_FALLBACK_PRIVATE=groq,ollama
# Groq free tier (console.groq.com), kein Training mit den Daten
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Google AI Studio free tier (aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Lokal und offline. Einmalig: ollama pull qwen2.5:7b-instruct
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# ── Termine aus Mails (mail_events.py) ───────────────────────────────────────
# Alle 30 Minuten ab JARVIS_MAIL_EVENTS_HOUR bis 22 Uhr. 0 = aus.
JARVIS_MAIL_EVENTS_DAILY=1
JARVIS_MAIL_EVENTS_HOUR=7
# Diese Absender-Domains (auch Unterdomains) trägt Jarvis ohne Karte ein, mit Meldung und "rückgängig".
JARVIS_MAIL_EVENTS_TRUSTED=pccaddie-online.de,golftimer.de,golfhouse.de

# ── Websuche ────────────────────────────────────────────────────────────────
# 1 = jede Anfrage an Claude darf im Web suchen, wenn Notizen und Werkzeuge nicht reichen
# (private Daten kommen nie in die Suche). 0 = nur, wenn der Satz danach fragt.
JARVIS_WEB_ALWAYS=1

# ── Fernzugriff (iPhone/iPad über Tailscale, siehe docs/bedienung.md) ──────────────────
# 1 = zweiter Port nur für gekoppelte Geräte, erreichbar über "tailscale serve"
JARVIS_REMOTE=0
JARVIS_REMOTE_PORT=8721
# Erlaubte Hostnamen, Komma-getrennt (leer = alles unter *.ts.net)
JARVIS_REMOTE_HOSTS=

# ── Kalender (iCloud / CalDAV) ──────────────────────────────────────────────
# App-spezifisches Passwort: account.apple.com → Anmelden und Sicherheit
ICLOUD_USER=
ICLOUD_APP_PASSWORD=
# ICLOUD_CALENDARS=Privat,Arbeit
# ICLOUD_DEFAULT_CALENDAR=Privat

# ── E-Mail (IMAP, nur lesen) ────────────────────────────────────────────────
MAIL_IMAP_HOST=
MAIL_USER=
MAIL_PASSWORD=
# optional: Name, unter dem Jarvis das Konto nennt
MAIL_NAME=
# Weitere Konten: MAIL2_…, MAIL3_… (bis MAIL9_), gleiche Felder. Jarvis liest alle;
# Entwürfe landen im ersten, außer man nennt ein anderes ("Entwurf aus Gmail").
# MAIL2_IMAP_HOST=imap.gmail.com
# MAIL2_USER=
# MAIL2_PASSWORD=
# MAIL2_NAME=Gmail
# So weit schaut Jarvis höchstens zurück (Posteingang, Termine aus Mails, Pakete), in Stunden.
JARVIS_MAIL_LOOKBACK_HOURS=24

# ── Paketverfolgung (shipments.py) ──────────────────────────────────────────
# Lieferungen aus den Versandmails -> ganztägiger Termin, Erinnerung am Liefertag. 0 = aus.
JARVIS_SHIPMENTS=1
# Live-Status und Liefertag für alle Paketdienste (DHL, Hermes, DPD, GLS, UPS ...): Schlüssel von
# 17track.net (Konto -> API). Kostenloses Kontingent; nur das erste Anmelden einer Sendung verbraucht davon.
# 17TRACK sieht dann die Sendungsnummern.
TRACK17_API_KEY=
# Alternativ nur DHL, direkt bei DHL (developer.dhl.com, "Shipment Tracking - Unified")
DHL_API_KEY=
# Sofortlieferdienste und Lebensmittel: keine Sendung für den Kalender (Komma-Liste von Domains)
JARVIS_SHIPMENTS_IGNORE=uber.com,ubereats.com,goflink.com,wolt.com,lieferando.de,deliveroo.de,getir.com,gorillas.io,knuspr.de,picnic.app,rewe.de,flaschenpost.de

# ── Smart Home (Home Assistant) ─────────────────────────────────────────────
HA_URL=http://homeassistant.local:8123
# Langlebiges Zugriffstoken: HA-Profil → Sicherheit
HA_TOKEN=
# Optional: MCP-Server in Home Assistant (Automationen, Verlauf, Logs) — nur bei Bedarf geladen
HA_MCP_URL=
# Geräte-Zuordnung fürs Dashboard: config/home.json (Vorlage config/home.example.json)
# 3D-Drucker (Bambu, Integration ha-bambulab): wird von selbst gefunden. Bei mehreren Druckern
# hier den Entity-Präfix eintragen (z. B. x1c_00m09d490200379), 0 = keine Druckerfragen und -ansagen.
JARVIS_PRINTER=

# ── Heimnetz ────────────────────────────────────────────────────────────────
# Raspberry Pi / Home-Server per SSH-Schlüssel (nur lesender Statusbefehl ohne Rückfrage)
JARVIS_PI_HOST=
JARVIS_PI_USER=pi
# Homelab figures (homelab.py). Prometheus and Pi-hole default to the Pi above.
# PIHOLE_PASSWORD: an app password from Pi-hole -> Settings -> Web interface / API.
PROMETHEUS_URL=
PIHOLE_URL=
PIHOLE_PASSWORD=
# Lagebericht (situation.py), defaults to the Pi above. Uptime Kuma is read from a public
# status page with this slug (Kuma -> Statusseiten -> neue Seite, alle Monitore hinzufügen).
KUMA_URL=
JARVIS_KUMA_SLUG=jarvis
# ORBIT security centre (report at /api/security) and how old its last scan may be
JARVIS_ORBIT_URL=
JARVIS_ORBIT_STALE_HOURS=2
# Strompreis in Euro pro kWh für die Stromkosten (power_costs.py)
JARVIS_POWER_PRICE=0.35
# Check beim Verlassen der Wohnung (away_check.py): Minuten weg, bevor er prüft; 0 = aus
JARVIS_AWAY_MINUTES=3
JARVIS_AWAY_CHECK=1
# Wochenbericht fürs Heimnetz am Sonntag (homelab_review.py)
JARVIS_HOMELAB_REVIEW=1
# Willkommen zurück: erst nach so vielen Minuten weg (away_check.py)
JARVIS_WELCOME_MINUTES=20
# Unwetter des DWD über Bright Sky (weather_alerts.py): ab welcher Stufe (minor, moderate, severe, extreme)
JARVIS_WEATHER_ALERTS=1
JARVIS_ALERTS_MIN=moderate
# Gewohnheiten im Haus (house_habits.py): an so vielen Tagen zur gleichen Zeit = Gewohnheit
JARVIS_HABITS=1
JARVIS_HABITS_MIN_DAYS=4
# Morgen-Briefing im Wohnzimmer (morning_echo.py): ab dieser Stunde, bis JARVIS_BRIEFING_UNTIL
JARVIS_MORNING_ECHO=1
JARVIS_MORNING_FROM=5
# Antworten über den Echo: so viele Zeichen spricht Alexa pro Sekunde (alexa_voice.py)
JARVIS_ALEXA_CHARS_PER_S=15
# Nachts (JARVIS_QUIET_HOURS) spricht das Echo mit dieser Lautstärke, danach kommt die alte zurück
JARVIS_ALEXA_NIGHT_VOLUME=0.2
# Synology NAS (eigener DSM-Benutzer, nur Lesen)
SYNOLOGY_URL=
SYNOLOGY_USER=
SYNOLOGY_PASSWORD=
# FRITZ! repeaters without their own HA integration, comma-separated (updates.py reads their version
# without login and compares it with download.avm.de; report only)
JARVIS_FRITZ_REPEATERS=

# ── Gesundheit (Garmin Connect) ─────────────────────────────────────────────
GARMIN_EMAIL=
GARMIN_PASSWORD=
# Garmin als Auslöser (wellbeing.py): schlechte Nacht = schonender Vormittag (bis JARVIS_WB_UNTIL Uhr)
JARVIS_WELLBEING=1
JARVIS_WB_SLEEP_LOW=60
JARVIS_WB_STRESS_HIGH=50
JARVIS_WB_BATTERY_LOW=30
JARVIS_WB_UNTIL=12
# abends ab dieser Stunde: Body Battery darunter = Hinweis auf einen frühen Abend
JARVIS_WB_EVENING=21
JARVIS_WB_BATTERY_EVENING=25
JARVIS_WB_VOLUME=0.75

# ── Smarter: Gewohnheiten, Losfahren, Budget, Wartung, Stimme, Fokus, Selbstkontrolle ──────
# Gewohnheiten des Users (user_habits.py): dieselbe Frage an so vielen Tagen zur gleichen Zeit
JARVIS_USER_HABITS=1
JARVIS_USER_HABITS_MIN_DAYS=4
# Vor dem Losfahren zu einem Termin (departure.py): so viele Minuten vor der Losfahrzeit
JARVIS_DEPARTURE_PREP_MIN=30
# Strombudget im Monat in Euro (power_costs.py), 0 = aus; alternativ budget_eur in config/energy_coach.json
JARVIS_POWER_BUDGET_EUR=0
# Wartungskalender (maintenance.py): Zertifikate, Docker-Images, Backup-Alter aus config/homelab.json → maintenance
JARVIS_MAINTENANCE=1
# Stimme nach Tageszeit (daytime.py): flüstern in diesen Stunden (leer = Ruhezeiten), leiser/langsamer ab LATE_FROM
JARVIS_DAYTIME_VOICE=1
JARVIS_WHISPER_HOURS=
JARVIS_LATE_FROM=21
JARVIS_LATE_VOLUME=0.8
JARVIS_LATE_SPEED=1.08
# Fokus-Sitzungen (focus.py): Standarddauer, Hinweis nach so vielen Minuten Ablenkung, Fenstertitel die ablenken
JARVIS_FOCUS_DEFAULT_MIN=45
JARVIS_FOCUS_WARN_MIN=10
# JARVIS_FOCUS_DISTRACT=youtube|netflix|twitch|reddit|twitter|instagram|tiktok
# Selbstkontrolle (selfcheck.py): eine umformulierte Frage innerhalb von so vielen Sekunden = Fehlschlag
JARVIS_SELFCHECK_SECONDS=25
# Handy als Karte (phone_actions.py): der Helfer in Home Assistant, in den die Automation die Antwort schreibt
JARVIS_PHONE_ACTION_ENTITY=input_text.jarvis_phone_action

# ── Paperless-ngx (gescannte Post, nur lesen) ───────────────────────────────
PAPERLESS_URL=
PAPERLESS_TOKEN=

# ── UniFi (Netzwerk-Controller, nur lesen): API-Schlüssel oder Benutzer ─────
UNIFI_URL=
UNIFI_API_KEY=
UNIFI_USER=
UNIFI_PASSWORD=
UNIFI_SITE=default
UNIFI_VERIFY_TLS=0

# ── Jellyfin (Mediathek): Abspielen auf Geräten mit Jellyfin-App ────────────
JELLYFIN_URL=
JELLYFIN_API_KEY=
JELLYFIN_USER=
JELLYFIN_TV=fire

# ── API-Guthaben in $ (optional) ────────────────────────────────────────────
# Anthropic-Key für die Cost API — NICHT als ANTHROPIC_API_KEY eintragen
JARVIS_COST_KEY=
